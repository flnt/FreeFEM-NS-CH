// ========================================================================================================
// WITHDRAWING PLATE (2D) - NS + Cahn-Hilliard Phase-Field (FreeFEM++)
// Based on your reference code: bulk equations unchanged
// Only: (i) add gravity to NS, (ii) correct BCs for withdrawing plate
// ========================================================================================================

verbosity = 0;

load "gmsh";
load "iovtk";
load "UMFPACK64";
load "isoline";
load "Element_P3";

include "include_postProc.idp"

exec("mkdir -p data");

// --------------------------------------------------------------------------------------------------------
// PARAMETERS (keep what you want; these are placeholders in the same style as your code)
// --------------------------------------------------------------------------------------------------------
real Ca  = 0.14;
real Cn  = 0.05;
real Re  = 1.0;
real Pe  = 1000.;

real thE = pi/2.0;
real cTh = cos(thE);
real ls = 0.05;

// Contact line friction (keep structure)
real mufa = 0.0;
real mufr = 0.0;
func muf  = mufa;

// Phase-dependent viscosity and density parameters (same style as your original)
real mu2  = sqrt(Ca);
real rho2 = 0.2;

// Gravity (y-direction). Use negative for downward.
real grav = -1.25;

// Withdrawal speed (plate moving upward)
real Vs = 1.; //sqrt(Ca);

// Domain size
real L = 10.0;
real H = 10.0;

// // Mesh resolution / adaptation
int  n    = 6;
real refI = 4.0;
real mGrw = 1.2;

// int  n    = 8;
// real refI = 6.0;
// real mGrw = 1.2;

// Time
real dt   = 0.002;
real tfin = 10.;
real tout = 0.1;
int  dref = 25;
int  bNew = 0;

// --------------------------------------------------------------------------------------------------------
// INITIAL CONDITION: flat interface at y = yInterface
// Convention matches your rho/mu laws: c=+1 fluid1, c=-1 fluid2
// Here: liquid below, gas above => +1 below, -1 above achieved by initC below.
// --------------------------------------------------------------------------------------------------------
real yInterface = 3.5;
func initC = -tanh( (y - yInterface)/sqrt(2)/Cn );

// --------------------------------------------------------------------------------------------------------
// MESH with boundary labels:
// 1 = bottom, 2 = right (far), 3 = top (open), 4 = left (moving plate)
// --------------------------------------------------------------------------------------------------------
border bnd1(t=0,L) { x=t; y=0; label=1; }    // bottom
border bnd2(t=0,H) { x=L; y=t; label=2; }    // right (far)
border bnd3(t=L,0) { x=t; y=H; label=3; }    // top (open)
border bnd4(t=H,0) { x=0; y=t; label=4; }    // left (plate)

mesh Th = buildmesh( bnd1(n*L) + bnd2(n*H) + bnd3(n*L) + bnd4(n*H) );
plot(Th, wait=false);

// --------------------------------------------------------------------------------------------------------
// FE SPACES (NO periodicity for withdrawing plate)
// --------------------------------------------------------------------------------------------------------
fespace Ph2 (Th, P2);
fespace Ph1 (Th, P1);
fespace PFh1(Th, [P1,P1]);
fespace FLh (Th, [P2,P2,P1]);

FLh  [u,v,p], [uu,vv,pp], [uO,vO,pO];
PFh1 [fi,c],  [fifi,cc],  [fiO,cO];

Ph2 str, vstr;

// --------------------------------------------------------------------------------------------------------
// MATERIAL LAWS (unchanged style)
// --------------------------------------------------------------------------------------------------------
func rho  = (c >=-1.0)*(c <=1.0)*0.5*(c +1-rho2*(c -1)) + (c <-1.0)*rho2 + (c >1.0);
func rhoO = (cO>=-1.0)*(cO<=1.0)*0.5*(cO+1-rho2*(cO-1)) + (cO<-1.0)*rho2 + (cO>1.0);

func mu   = (c >=-1.0)*(c <=1.0)*0.5*(c +1-mu2 *(c -1)) + (c <-1.0)*mu2  + (c >1.0);
func muO  = (cO>=-1.0)*(cO<=1.0)*0.5*(cO+1-mu2 *(cO-1)) + (cO<-1.0)*mu2  + (cO>1.0);

// --------------------------------------------------------------------------------------------------------
// MESH ADAPTATION (no periodic)
// --------------------------------------------------------------------------------------------------------
macro getAdaptMesh()
Th = adaptmesh(Th,c,hmin=1.0/(n*refI),hmax=1.0/n,iso=true,ratio=mGrw,err=0.001,nbvx=1e8);
[uu,vv,pp] = [0,0,0]; [fifi,cc] = [0,0];
[u,v,p]    = [u,v,p]; [uO,vO,pO] = [uO,vO,pO];
[fi,c]     = [fi,c];  [fiO,cO]   = [fiO,cO];
// EOM

macro solveNonLinPFeq()
eq12phasefield;
cout << "PF done ";
// EOM

macro solveNonLinNSeq()
NStokesExpl;
cout << "NS done ";
// EOM

// --------------------------------------------------------------------------------------------------------
// (Optional) CFL check (same structure as your code)
// --------------------------------------------------------------------------------------------------------
real maxCFL;
int nt;
real mgU, xa, xb, ya, yb, ds;

macro getMaxCFL()
nt = Th.nt;
maxCFL = 0.0;
for(int i=0; i<nt; i++)
{
  for(int j=0; j<3; j++)
  {
    xa = Th[i][ j     ].x; ya = Th[i][ j     ].y;
    xb = Th[i][(j+1)%3].x; yb = Th[i][(j+1)%3].y;
    ds = sqrt((xb-xa)^2+(yb-ya)^2);
    mgU = max(sqrt(u(xa,ya)^2+v(xa,ya)^2),sqrt(u(xb,yb)^2+v(xb,yb)^2));
    maxCFL = max(maxCFL,mgU*dt/ds);
  }
}
// EOM

// --------------------------------------------------------------------------------------------------------
// CONTACT LINE on plate (x=0): find y such that c(0,y)=0
// --------------------------------------------------------------------------------------------------------
real yCL = yInterface;
real tolBi = 1.0e-8, ay, by, cy;
int Icur, Imax = 200;

func real getCLposition()
{
  ay = 0.0; by = H; cy = 0.5*(ay+by);
  Icur = 0;

  // If no sign change, return previous value (avoids infinite loop)
  if( sign(c(0.0,ay)) == sign(c(0.0,by)) ) return yCL;

  while( abs(c(0.0,cy)) > tolBi )
  {
    if( sign(c(0.0,cy)) == sign(c(0.0,ay)) ) ay = cy; else by = cy;
    cy = 0.5*(ay+by);
    Icur++;
    if(Icur > Imax) { cout << "Warning: getCLposition did not converge\n"; break; }
  }
  return cy;
}

macro updCLcoord()
yCL = getCLposition();
// EOM

// ========================================================================================================
// CAHN–HILLIARD EQUATIONS (BULK UNCHANGED)
// Only BC change: wetting/contact-angle terms applied ONLY on plate (label 4)
// and boundary convection term applied on all boundaries (1,2,3,4).
// ========================================================================================================
problem eq12phasefield([fi,c],[fifi,cc],solver=sparsesolver,master=0)
    = int2d(Th)    ( dt*fi*fifi - dt*c*(cO^2  )*fifi - dt*Cn^2*(dx(c)*dx(fifi)+dy(c)*dy(fifi))  )
    + int2d(Th)    (                     +dt*cO*fifi                                            )

    // --- WETTING / CONTACT ANGLE + CONTACT LINE FRICTION: PLATE ONLY (label 4)
    + int1d(Th,4)  ( -dt*sqrt(2)/2*Cn*cTh*c*cO*fifi  - 2*sqrt(2)/3*Cn^2*Ca*muf*(c  + dt*uO*dx(c)+dt*vO*dy(c) )*fifi )
    + int1d(Th,4)  (  dt*sqrt(2)/2*Cn*cTh     *fifi  + 2*sqrt(2)/3*Cn^2*Ca*muf* cO                            *fifi )

    + int2d(Th)    ( c *cc - dt*c*(uO*dx(cc)+vO*dy(cc)) + dt*3/(4*sqrt(2))/Pe*(dx(fi )*dx(cc)+dy(fi )*dy(cc)) )
    + int2d(Th)    (-cO*cc                              + dt*3/(4*sqrt(2))/Pe*(dx(fiO)*dx(cc)+dy(fiO)*dy(cc)) )

    // --- CONSERVATIVE ADVECTION BOUNDARY FLUX: ALL BOUNDARIES in non-periodic domain
    + int1d(Th,1,2,3,4)( dt*c*(uO*N.x+vO*N.y)*cc )

    + on(2, c = initC);

// ========================================================================================================
// NAVIER–STOKES (BULK UNCHANGED)
// Only additions:
//   - Gravity term (volume force in y-direction)
//   - Withdrawing-plate BCs:
//        bottom (1): u=0, v=0
//        plate  (4): u=0, v=Vs
//        top    (3): p=0  (pressure reference / open)
//        right  (2): natural (do-nothing) open/far
// ========================================================================================================
problem NStokesExpl([u,v,p],[uu,vv,pp],solver=sparsesolver,master=0)
    = int2d(Th)(   dt/Re*(-p + 2.0*mu*dx(u))*dx(uu) + dt/Re*mu*(dy(u)+dx(v))*dy(uu)
                 + dt/Re*(-p + 2.0*mu*dy(v))*dy(vv) + dt/Re*mu*(dx(v)+dy(u))*dx(vv)
                   - (dx(u)+dy(v))*pp - 1e-10*p*pp
                + rho *( (u *uu+v *vv) + dt*(uO*dx(u )+vO*dy(u ))*uu + dt*(uO*dx(v )+vO*dy(v ))*vv
                                       + dt*(u *dx(uO)+v *dy(uO))*uu + dt*(u *dx(vO)+v *dy(vO))*vv )  )
    + int2d(Th)(  rho *(-(uO*uu+vO*vv) - dt*(uO*dx(uO)+vO*dy(uO))*uu - dt*(uO*dx(vO)+vO*dy(vO))*vv )
                 - 3/(2*sqrt(2))*dt*fiO*(dx(cO)*uu+dy(cO)*vv)/(Cn*Ca*Re) )

    // --- GRAVITY: body force in y-direction (use grav<0 for downward)
    + int2d(Th)( dt*rho*grav*vv )

    + int1d(Th,4)( dt/Re*mu/ls*v*vv ) + int1d(Th,4)(-dt/Re*mu/ls*Vs*vv )

    // --- WITHDRAWING PLATE BCs
    + on(1, u=0, v=0)        // bottom no-slip
    + on(2, u=0, v=0)        // right no-slip
    // + on(4, u=0, v=Vs)       // plate moving upward for no slip
    + on(4, u=0)       // plate moving upward for slip
    + on(3, p=0);            // open/top pressure reference

// ========================================================================================================
// INITIALISATION
// ========================================================================================================
[fi,c] = [0,initC];

// Initial mesh adaptation passes
getAdaptMesh
[fi,c] = [0,initC];
getAdaptMesh
[fi,c] = [0,initC];
getAdaptMesh
[fi,c] = [0,initC];

// Initial velocity: at rest (or you can seed a Couette profile if desired)
// Here: rest
[u,v,p] = [0,0,0];

// Initialise old fields consistently
[uO,vO,pO] = [u,v,p];
[fiO,cO]   = [fi,c];

// Initial CL
updCLcoord

// Output initial state
int nAout = 0, nAdapt = 0;
real curt = 0.0;

savevtk("data/out_"+nAout+".vtk",Th,[u,v],p,c,fi,rho,mu,str,dataname="velocity pressure cvar phivar rho mu str");
savemesh(Th,"data/out_"+nAout+".msh");
{
  ofstream resfile("data/out_"+nAout+".dat");
  resfile << u[] << v[] << p[] << fi[] << c[];
}
{
  ofstream st("stats.txt");
  st << "# t  yCL\n";
  st << curt << " " << yCL << "\n";
}
nAout++;

// Plot
plot(c,fill=1,value=1,wait=false);

// ========================================================================================================
// TIME LOOP
// ========================================================================================================
int nTsteps = tfin/dt;

for(int it=1; it<=nTsteps; it++)
{
  if(nAdapt == dref)
  {
    cout << "Mesh adapt... ";
    getAdaptMesh
    nAdapt = 0;
  }

  curt += dt;
  cout << "t=" << curt << ", ";

  solveNonLinPFeq
  cout << " ";
  solveNonLinNSeq

  getMaxCFL
  updCLcoord

  cout << " CFL " << maxCFL << " yCL " << yCL << endl;

  {
    ofstream st("stats.txt",append);
    st << curt << " " << yCL << "\n";
  }

  if( abs(curt - nAout*tout) < 0.01*tout )
  {
    solve streamlines(str,vstr,solver=sparsesolver,master=0) =
         int2d(Th)( - (dx(str)*dx(vstr)+dy(str)*dy(vstr)) - 1.0e-10*str*vstr )
       + int1d(Th,1,2,3,4)( (-v*N.x+u*N.y)*vstr )
       + int2d(Th)( (dx(v) - dy(u))*vstr );

    savevtk("data/out_"+nAout+".vtk",Th,[u,v],p,c,fi,rho,mu,str,dataname="velocity pressure cvar phivar rho mu str");
    savemesh(Th,"data/out_"+nAout+".msh");
    {
      ofstream resfile("data/out_"+nAout+".dat");
      resfile << u[] << v[] << p[] << fi[] << c[];
    }
    nAout++;
  }

  // Update old fields
  [uO,vO,pO] = [u,v,p];
  [fiO,cO]   = [fi,c];

  nAdapt++;
}

// ========================================================================================================
// FINAL OUTPUT
// ========================================================================================================
savevtk("data/out_Final.vtk",Th,[u,v],p,c,fi,rho,mu,str,dataname="velocity pressure cvar phivar rho mu str");
savemesh(Th,"data/out_Final.msh");
{
  ofstream resfile("data/out_Final.dat");
  resfile << u[] << v[] << p[] << fi[] << c[];
}

cout << "Done. Final yCL=" << yCL << endl;