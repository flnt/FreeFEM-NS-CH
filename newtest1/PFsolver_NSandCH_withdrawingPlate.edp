// ========================================================================================================
// WITHDRAWING PLATE SIMULATION
// ========================================================================================================
// This code simulates a 2D withdrawing plate where the initial interface is flat and horizontal.
// The left boundary moves upward with velocity V_s, and gravity acts downward.
// The goal is to extract the contact line position on the left boundary as a function of time.
// ========================================================================================================

// Level of output
verbosity = 0;

load "gmsh";
load "iovtk";
load "UMFPACK64";
load "isoline";
load "Element_P3";
// load "MUMPS";  // Uncomment for potentially faster solver

include "include_postProc.idp"

// ========================================================================================================
// PHYSICAL PARAMETERS
// ========================================================================================================

// Fluid properties
real rho1 = 1.0;      // Density of fluid 1 (liquid)
real rho2 = 0.2;      // Density of fluid 2 (gas)
real grav = -1.25;    // Gravity (negative = downward)
real sig = 1.0;       // Surface tension
real lc = 1.0;        // Capillary length

// Non-dimensional parameters
real Ca = 0.15;             // Capillary number
real eps = 0.05;            // Interface thickness parameter (Cahn number Cn)
real angleEq = pi/2.0;      // Equilibrium contact angle (90 degrees)

// Derived parameters
real Vs = sqrt(Ca);         // Withdrawal velocity (V_s ~ 0.374)
real mu1 = Vs;              // Viscosity of fluid 1
real mu2 = Vs;              // Viscosity of fluid 2

// Domain dimensions (SQUARE DOMAIN)
real L = 10.0*lc;           // Horizontal extent
real H = 10.0*lc;          // Vertical extent (square domain)

// Rename for compatibility with reference code
real Cn = eps;              // Cahn number
real mu2ratio = mu2/mu1;    // Viscosity ratio
real rho2ratio = rho2/rho1; // Density ratio
real thE = angleEq;         // Contact angle

// Calculate Reynolds and Peclet numbers (similar to reference codes)
real Re = rho1*Vs*lc/mu1;   // Reynolds number
real Pe = 1.0; // Vs*lc*Ca/Cn;      // Peclet number

// Contact line friction (zero for now)
real mufa = 0.0;            // Advancing contact line friction
real mufr = 0.0;            // Receding contact line friction

cout << "===================================" << endl;
cout << "WITHDRAWING PLATE SIMULATION" << endl;
cout << "===================================" << endl;
cout << "Physical parameters:" << endl;
cout << "  Ca = " << Ca << endl;
cout << "  Cn = " << Cn << endl;
cout << "  Re = " << Re << endl;
cout << "  Pe = " << Pe << endl;
cout << "  V_s = " << Vs << endl;
cout << "  Equilibrium angle = " << angleEq*180.0/pi << " degrees" << endl;
cout << "  L = " << L << ", h_0 = " << H << endl;
cout << "  Gravity = " << grav << endl;
cout << "===================================" << endl;

// ========================================================================================================
// MESH PARAMETERS
// ========================================================================================================

// OPTIMIZED for speed: coarser initial mesh, less frequent adaptation
int n = 7;               // Number of segments per unit length (reduced from 10)
real refI = 4.0;         // Refinement factor for the interface (reduced from 8)
real mGrw = 1.2;         // Growth rate of mesh elements

// ========================================================================================================
// TIME STEPPING AND OUTPUT PARAMETERS
// ========================================================================================================

// OPTIMIZED for speed: larger time step, less frequent output
real dt = 0.002;         // Time step (increased from 0.001)
real tfin = 20.0;        // Final time
real tout = 0.2;         // Output interval (increased from 0.1)
int dref = 20;           // Number of time-steps between mesh adaptation (increased from 20)
int bNew = 1;            // 1 = start new simulation; 0 = restart from previous state

// Limiting maximum number of iterations
int Icur, Imax = 100;

// ========================================================================================================
// INITIAL CONDITION - FLAT INTERFACE
// ========================================================================================================

// Initial interface position (flat horizontal line at y = 3.5)
real yInterface = 1.75*lc;

// Phase field initialization: -1 below interface (fluid 2/gas), +1 above (fluid 1/liquid)
func initC = -tanh((y - yInterface)/sqrt(2)/Cn);

// ========================================================================================================
// DOMAIN AND MESH DEFINITION
// ========================================================================================================

// Define the mesh boundaries (1=bottom, 2=right, 3=top, 4=left)
border bnd1(t=0,L)    {x=t; y=0;  label=1; }  // Bottom
border bnd2(t=0,H)   {x=L; y=t;  label=2; }  // Right
border bnd3(t=L,0)    {x=t; y=H; label=3; }  // Top
border bnd4(t=H,0)   {x=0; y=t;  label=4; }  // Left (withdrawing plate)

// Create initial mesh
mesh Th = buildmesh(bnd1(n*L) + bnd2(n*H) + bnd3(n*L) + bnd4(n*H));
plot(Th, wait=false);

// ========================================================================================================
// FINITE ELEMENT SPACES AND FUNCTIONS
// ========================================================================================================

// Define FE spaces (NO periodic boundary conditions for this problem)
fespace Ph2 (Th, P2);
fespace Ph1 (Th, P1);
fespace PFh1(Th, [P1,P1]);
fespace FLh (Th, [P2,P2,P1]);

// Flow variables
FLh [u,v,p], [uu,vv,pp], [uO,vO,pO];

// Phase field variables
PFh1 [fi,c], [fifi,cc], [fiO,cO];

// Streamline for visualization
Ph2 str, vstr;

// ========================================================================================================
// MATERIAL PROPERTIES AS FUNCTIONS OF PHASE FIELD
// ========================================================================================================

// Density and viscosity vary smoothly across the interface
func rho = (c >= -1.0)*(c <= 1.0)*0.5*(c + 1 - rho2ratio*(c - 1)) + (c < -1.0)*rho2ratio + (c > 1.0);
func rhoO= (cO >= -1.0)*(cO <= 1.0)*0.5*(cO + 1 - rho2ratio*(cO - 1)) + (cO < -1.0)*rho2ratio + (cO > 1.0);
func mu  = (c >= -1.0)*(c <= 1.0)*0.5*(c + 1 - mu2ratio*(c - 1)) + (c < -1.0)*mu2ratio + (c > 1.0);
func muO = (cO >= -1.0)*(cO <= 1.0)*0.5*(cO + 1 - mu2ratio*(cO - 1)) + (cO < -1.0)*mu2ratio + (cO > 1.0);

// Contact line friction
func muf = mufa;

// ========================================================================================================
// MACROS FOR MESH ADAPTATION AND SOLUTION
// ========================================================================================================

// Mesh adaptation
macro getAdaptMesh()
Th = adaptmesh(Th, c, hmin=1.0/(n*refI), hmax=1.0/n, iso=true, ratio=mGrw, err=0.001, nbvx=1e8);
[uu,vv,pp] = [0,0,0]; [fifi,cc] = [0,0];
[u,v,p] = [u,v,p]; [uO,vO,pO] = [uO,vO,pO];
[fi,c] = [fi,c]; [fiO,cO] = [fiO,cO];
// EOM

// Solve phase field equations
macro solveNonLinPFeq()
eq12phasefield;
cout << "PF done ";
// EOM

// Solve Navier-Stokes equations
macro solveNonLinNSeq()
NStokesExpl;
cout << "NS done ";
// EOM

// Maximum CFL number
real maxCFL;
int nt;
real mgU, xa, xb, ya, yb, ds;
macro getMaxCFL()
nt = Th.nt;
maxCFL = 0.0;
for(int i=0; i<nt; i++)
{
    for(int j=0; j<3; j++)
    {
        xa = Th[i][j].x; ya = Th[i][j].y;
        xb = Th[i][(j+1)%3].x; yb = Th[i][(j+1)%3].y;
        ds = sqrt((xb-xa)^2 + (yb-ya)^2);
        mgU = max(sqrt(u(xa,ya)^2 + v(xa,ya)^2), sqrt(u(xb,yb)^2 + v(xb,yb)^2));
        maxCFL = max(maxCFL, mgU*dt/ds);
    }
}
// EOM

// Maximum Von Neumann number
real maxVN;
macro getMaxVN()
nt = Th.nt;
maxVN = 5.0;
for(int i=0; i<nt; i++)
{
    for(int j=0; j<3; j++)
    {
        xa = Th[i][j].x; ya = Th[i][j].y;
        xb = Th[i][(j+1)%3].x; yb = Th[i][(j+1)%3].y;
        ds = sqrt((xb-xa)^2 + (yb-ya)^2);
        maxVN = min(maxVN, ds);
    }
}
maxVN = 1/Pe*dt/maxVN^2;
// EOM

// ========================================================================================================
// CONTACT LINE EXTRACTION ON LEFT BOUNDARY
// ========================================================================================================

// Variables for contact line position
real yCL = yInterface;  // Contact line vertical position on left boundary

// Function to find contact line position on left boundary (x=0)
real tolBi = 1.0e-8, ay, by, cy;
func real getCLposition()
{
    // Binary search for y-coordinate where c(0,y) = 0 on the left boundary
    ay = 0.0; by = H; cy = 0.5*(ay + by);
    Icur = 0;
    while(abs(c(0.0, cy)) > tolBi)
    {
        if(sign(c(0.0, cy)) == sign(c(0.0, ay))) ay = cy; else by = cy;
        cy = 0.5*(ay + by); 
        Icur++;
        if(Icur > Imax) {
            cout << "Warning: Failed to converge in getCLposition!" << endl; 
            break;
        }
    }
    return cy;
}

// Macro to update contact line position
macro updCLcoord()
{
    yCL = getCLposition();
}
// EOM

// ========================================================================================================
// COSINE OF EQUILIBRIUM CONTACT ANGLE
// ========================================================================================================

real cTh = cos(thE);

// ========================================================================================================
// CAHN-HILLIARD EQUATIONS WITH WETTING BOUNDARY CONDITION
// ========================================================================================================

problem eq12phasefield([fi,c], [fifi,cc], solver=sparsesolver, master=0)
    = int2d(Th)    ( dt*fi*fifi - dt*c*(cO^2)*fifi - dt*Cn^2*(dx(c)*dx(fifi) + dy(c)*dy(fifi)) )
    + int2d(Th)    ( dt*cO*fifi )
    // Wetting boundary condition on bottom (label 1) and left wall (label 4)
    + int1d(Th,2,4)( -dt*sqrt(2)/2*Cn*cTh*c*cO*fifi - 2*sqrt(2)/3*Cn^2*Ca*muf*(c + dt*uO*dx(c) + dt*vO*dy(c))*fifi )
    + int1d(Th,2,4)( dt*sqrt(2)/2*Cn*cTh*fifi + 2*sqrt(2)/3*Cn^2*Ca*muf*cO*fifi )
    + int2d(Th)    ( c*cc - dt*c*(uO*dx(cc) + vO*dy(cc)) + dt*3/(4*sqrt(2))/Pe*(dx(fi)*dx(cc) + dy(fi)*dy(cc)) )
    + int2d(Th)    ( -cO*cc + dt*3/(4*sqrt(2))/Pe*(dx(fiO)*dx(cc) + dy(fiO)*dy(cc)) )
    // Convective flux through boundaries
    + int1d(Th,2,4)( dt*c*(uO*N.x + vO*N.y)*cc );

// ========================================================================================================
// NAVIER-STOKES EQUATIONS WITH GRAVITY
// ========================================================================================================

problem NStokesExpl([u,v,p], [uu,vv,pp], solver=sparsesolver, master=0)
    // Viscous terms
    = int2d(Th)(   dt/Re*(-p + 2.0*mu*dx(u))*dx(uu) + dt/Re*mu*(dy(u) + dx(v))*dy(uu)
                 + dt/Re*(-p + 2.0*mu*dy(v))*dy(vv) + dt/Re*mu*(dx(v) + dy(u))*dx(vv)
                 - (dx(u) + dy(v))*pp - 1e-10*p*pp
                 // Inertia terms
                 + rho*( (u*uu + v*vv) + dt*(uO*dx(u) + vO*dy(u))*uu + dt*(uO*dx(v) + vO*dy(v))*vv
                                       + dt*(u*dx(uO) + v*dy(uO))*uu + dt*(u*dx(vO) + v*dy(vO))*vv ) )
    // Old time step terms
    + int2d(Th)(  rho*(-(uO*uu + vO*vv) - dt*(uO*dx(uO) + vO*dy(uO))*uu - dt*(uO*dx(vO) + vO*dy(vO))*vv )
                  // Capillary force
                  - 3/(2*sqrt(2))*dt*fiO*(dx(cO)*uu + dy(cO)*vv)/(Cn*Ca*Re)
                  // GRAVITY TERM (acts in y-direction)
                  - dt*rho*grav*vv )
    // Boundary conditions:
    // Bottom (label 1): no-slip u=0, v=0
    // Right (label 2): no-slip u=0, v=0  
    // Left (label 4): moving wall u=0, v=V_s
    + on(1, u=0, v=0)
    + on(4, u=0, v=Vs);

// ========================================================================================================
// INITIALIZATION
// ========================================================================================================

cout << "Initializing phase field and adapting mesh..." << endl;

// Initialize phase field
[fi,c] = [0, initC];

// Initial mesh adaptation (3 passes for good quality)
getAdaptMesh
[fi,c] = [0, initC];
getAdaptMesh
[fi,c] = [0, initC];
getAdaptMesh
[fi,c] = [0, initC];

// Initialize velocity field (at rest initially)
[u,v,p] = [0, 0, 0];

// Store old values
uO[] = u[];
fiO[] = fi[];

// ========================================================================================================
// OUTPUT INITIALIZATION
// ========================================================================================================

int nAout, nAdapt, nRest;
real curt;

if(bNew == 1)
{
    // Start new simulation
    nAout = 0; nAdapt = 0; nRest = 0;
    curt = 0.0;
    
    // Get initial contact line position
    updCLcoord
    
    // Save initial state in VTK format
    savevtk("data/out_" + nAout + ".vtk", Th, [u,v], p, c, fi, rho, mu, str, 
            dataname="velocity pressure cvar phivar rho mu str");
    
    // Save mesh and data in FreeFEM format
    savemesh(Th, "data/out_" + nAout + ".msh");
    {
        ofstream resfile("data/out_" + nAout + ".dat");
        resfile << u[];
        resfile << fi[];
    }
    nAout++;
    
    // Create statistics file for contact line tracking
    {
        ofstream resfile("stats.txt");
        resfile << "# Withdrawing plate simulation - Contact line tracking" << endl;
        resfile << "# t, y_CL (contact line height on left boundary)" << endl;
        resfile << curt << " " << yCL << endl;
    }
    
    cout << "Initial state saved. Contact line at y = " << yCL << endl;
}
else if(bNew == 0)
{
    // Restart from previous state
    ifstream restxt("data/restart.txt");
    restxt >> nAout; restxt >> nAdapt; restxt >> curt;
    cout << "Restarting from previous state with curt = " << curt << endl;
    
    Th = readmesh("data/out_" + nAout + ".msh");
    [uu,vv,pp] = [0,0,0]; [fifi,cc] = [0,0];
    [u,v,p] = [0,0,0]; [uO,vO,pO] = [0,0,0];
    [fi,c] = [0,0]; [fiO,cO] = [0,0];
    
    ifstream resdat("data/out_" + nAout + ".dat");
    resdat >> uO[];
    resdat >> fiO[];
    nAout++;
    
    // Process statistics file
    exec("mv stats.txt stats_old.txt");
    ifstream prevst("stats_old.txt");
    ofstream updtst("stats.txt");
    updtst << "# Withdrawing plate simulation - Contact line tracking" << endl;
    updtst << "# t, y_CL (contact line height on left boundary)" << endl;
    
    string tmp;
    for(int i=0; i<2; i++) prevst >> tmp;
    real readt, tmpy;
    while(1)
    {
    prevst >> readt; prevst >> tmpy;
    updtst << readt << " " << tmpy << endl;
    if(abs(readt-curt) < 0.01*dt) break;
    }
    exec("rm stats_old.txt");
}
else
{
    cout << "Unknown bNew setting " << bNew << endl;
    exit(1);
}

// Plot initial mesh and phase field
plot(Th, wait=false);
plot(c, fill=1, value=1, wait=false);

// ========================================================================================================
// TIME STEPPING LOOP
// ========================================================================================================

cout << "Starting time stepping..." << endl;

int nTsteps = tfin/dt;
for(int i=1; i<nTsteps; i++)
{
    // plot(c,fill=1,value=1);
    
    // Mesh adaptation if needed
    if(nAdapt == dref)
    {
        cout << "    Mesh adapt 1, ";
        getAdaptMesh
        solveNonLinPFeq
        cout << " ";
        solveNonLinNSeq
        cout << endl << "    Mesh adapt 2, ";
        getAdaptMesh
        getMaxVN
        solveNonLinPFeq
        cout << " ";
        solveNonLinNSeq
        cout << ", VN = " << maxVN << endl;
        nAdapt++;
        nAdapt = 0;
    }
    
    // Advance time
    curt = curt + dt;
    cout << "t = " << curt << ", ";
    
    // Solve phase field equations
    solveNonLinPFeq
    
    // Solve Navier-Stokes equations
    cout << " ";
    solveNonLinNSeq
    
    // Get CFL number and contact line position
    getMaxCFL
    updCLcoord
    
    cout << " CFL " << maxCFL << " y_CL " << yCL << endl;
    
    // Visualize
    // plot(c, fill=1, value=1, wait=false);
    
    // Output to stats file
    {
        ofstream resfile("stats.txt", append);
        resfile << curt << " " << yCL << endl;
    }
    
    // Save data at regular intervals
    if(abs(curt - nAout*tout) < 0.01*tout)
    {
        cout << " Saving data to file " << nAout << " !" << endl;
        
        // Solve for streamlines
        solve streamlines(str, vstr, solver=sparsesolver, master=0) =
              int2d(Th)( -(dx(str)*dx(vstr) + dy(str)*dy(vstr)) - 1.0e-10*str*vstr )
            + int1d(Th,1,2,3,4)( (-v*N.x + u*N.y)*vstr )
            + int2d(Th)( (dx(v) - dy(u))*vstr );
        
        // Save VTK output
        savevtk("data/out_" + nAout + ".vtk", Th, [u,v], p, c, fi, rho, mu, str,
                dataname="velocity pressure cvar phivar rho mu str");
        
        // Save mesh and data
        savemesh(Th, "data/out_" + nAout + ".msh");
        {
            ofstream resfile("data/out_" + nAout + ".dat");
            resfile << u[];
            resfile << fi[];
        }
        
        // Save restart info
        {
            ofstream restxt("data/restart.txt");
            restxt << nAout << endl;
            restxt << nAdapt << endl;
            restxt << curt << endl;
        }
        
        nAout++;
        nRest++;
        
        real divChck = int2d(Th)(dx(u) + dy(v));
        cout << " Divergence of flow field = " << divChck << endl;
    }
    
    // Prepare for next time step
    uO[] = u[];
    fiO[] = fi[];
    nAdapt++;
    
    plot(v, fill=1, value=1, wait=false);
}

// ========================================================================================================
// FINAL OUTPUT
// ========================================================================================================

cout << "Simulation complete!" << endl;
{
    ofstream flag("simdone");
    flag << 1 << endl;
    
    cout << " Saving final data to file!" << endl;
    
    // Save final VTK
    savevtk("data/out_Final.vtk", Th, [u,v], p, c, fi, rho, mu, str,
            dataname="velocity pressure cvar phivar rho mu str");
    
    // Save final mesh and data
    savemesh(Th, "data/out_Final.msh");
    ofstream resfile("data/out_Final.dat");
    resfile << u[];
    resfile << fi[];
}

cout << "Final contact line position: y_CL = " << yCL << endl;
cout << "Results saved in stats.txt" << endl;
